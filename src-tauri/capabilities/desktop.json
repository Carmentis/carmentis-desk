{
  "identifier": "desktop-capability",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "updater:default",
    "sql:default",
    "sql:allow-execute",
    "process:default",
    "deep-link:default",
    "log:default",
    "stronghold:default",
    "os:default",
    "dialog:default",
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-read-file"
  ]
}